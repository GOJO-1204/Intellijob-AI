<div class="mx-auto max-w-3xl py-10">
  <h1 class="text-2xl font-semibold text-gray-900">Your job matches</h1>

  <div id="matches_list" class="mt-6">
    <% if @applications.empty? %>
      <%= render "matches/empty" %>
    <% else %>
      <ul class="space-y-3">
        <%= render partial: "job_applications/job_application", collection: @applications %>
      </ul>
    <% end %>
  </div>
</div>
