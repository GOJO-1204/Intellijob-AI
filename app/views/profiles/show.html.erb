<div class="mx-auto max-w-3xl py-10">
  <h1 class="text-2xl font-semibold text-gray-900">Your resume check</h1>
  <% tips = Array(@profile.ai_suggestions) %>

  <% if @profile.ats_score.nil? %>
    <p class="mt-4 text-sm text-gray-600">Analyzing your resume... This usually takes a few seconds.</p>
    <%= render "analysis_status", seconds_left: @seconds_left %>
  <% else %>
    <%= render "results", profile: @profile %>

    <h2 class="mt-8 text-lg font-semibold text-gray-900">AI writing tips</h2>
    <% if tips.any? %>
      <%= render "tips", tips: tips %>
    <% else %>
      <%= render "analysis_status", seconds_left: @seconds_left %>
    <% end %>
  <% end %>

  <%= link_to "Continue", edit_preferences_path, class: "mt-8 mr-4 inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  <%= link_to "Upload a new resume", new_profile_path, class: "mt-8 inline-block text-sm text-indigo-600 hover:underline" %>
</div>
