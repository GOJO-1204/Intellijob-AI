<div class="mx-auto max-w-3xl py-10">
  <h1 class="text-2xl font-semibold text-gray-900">Your resume check</h1>

  <% if @profile.ats_score.nil? %>
    <p class="mt-4 text-sm text-gray-600">Analyzing your resume... This usually takes a few seconds.</p>
    <%= link_to "Refresh", profile_path, class: "mt-4 inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  <% else %>
    <% checks = Array(@profile.ats_feedback["checks"]) %>
    <% shortcomings = Array(@profile.ats_feedback["shortcomings"]) %>
    <% tips = Array(@profile.ai_suggestions) %>

    <p class="mt-4 text-4xl font-bold text-gray-900">
      <%= @profile.ats_score %>
      <span class="text-lg font-normal text-gray-500">/ <%= checks.sum { |c| c["max"].to_i } %></span>
    </p>

    <h2 class="mt-8 text-lg font-semibold text-gray-900">Score breakdown</h2>
    <table class="mt-3 w-full text-left text-sm">
      <% checks.each do |c| %>
        <tr class="border-b border-gray-200">
          <td class="py-2 text-gray-700"><%= c["name"] %></td>
          <td class="py-2 text-right text-gray-900"><%= c["score"] %> / <%= c["max"] %></td>
        </tr>
      <% end %>
    </table>

    <h2 class="mt-8 text-lg font-semibold text-gray-900">What to fix</h2>
    <% if shortcomings.empty? %>
      <p class="mt-3 text-sm text-gray-600">No problems found. Nice work.</p>
    <% else %>
      <ul class="mt-3 space-y-3">
        <% shortcomings.each do |s| %>
          <li class="rounded-md border border-gray-200 p-3 text-sm">
            <p class="font-medium text-gray-900"><%= s["name"] %>: <%= s["issue"] %></p>
            <p class="mt-1 text-gray-600"><%= s["fix"] %></p>
          </li>
        <% end %>
      </ul>
    <% end %>

    <h2 class="mt-8 text-lg font-semibold text-gray-900">AI writing tips</h2>
    <% if tips.empty? %>
      <p class="mt-3 text-sm text-gray-600">No AI tips yet. If the analysis just finished, refresh in a moment.</p>
    <% else %>
      <ul class="mt-3 space-y-3">
        <% tips.each do |t| %>
          <li class="rounded-md border border-gray-200 p-3 text-sm">
            <p class="text-gray-500">Before: <%= t["original"] %></p>
            <p class="mt-1 text-gray-900">After: <%= t["improved"] %></p>
            <p class="mt-1 text-xs text-gray-600"><%= t["why"] %></p>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= link_to "Continue", edit_preferences_path, class: "mt-8 mr-4 inline-flex rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  <%= link_to "Upload a new resume", new_profile_path, class: "mt-8 inline-block text-sm text-indigo-600 hover:underline" %>
</div>
