<% checks = Array(profile.ats_feedback["checks"]) %>
<% shortcomings = Array(profile.ats_feedback["shortcomings"]) %>
<% total = checks.sum { |c| c["max"].to_i } %>
<% tones = {
     green: ["bg-green-50 text-green-800", "bg-green-600", "Strong"],
     amber: ["bg-amber-50 text-amber-800", "bg-amber-500", "Fair"],
     red: ["bg-red-50 text-red-800", "bg-red-600", "Weak"],
     gray: ["bg-gray-100 text-gray-700", "bg-gray-500", "Not rated"]
   } %>
<% pct = ->(score, max) { max.to_i.positive? ? score.to_f * 100 / max.to_i : nil } %>
<% tone_for = ->(score, max) { value = pct.(score, max); value.nil? ? :gray : (value >= 70 ? :green : (value >= 40 ? :amber : :red)) } %>

<% badge, _bar, word = tones[tone_for.(profile.ats_score, total)] %>
<div class="mt-4 flex items-center gap-3">
  <p class="text-4xl font-bold text-gray-900">
    <%= profile.ats_score %>
    <span class="text-lg font-normal text-gray-500">/ <%= total %></span>
  </p>
  <span class="rounded-md px-2 py-1 text-sm font-medium <%= badge %>"><%= word %></span>
</div>

<h2 class="mt-8 text-lg font-semibold text-gray-900">Score breakdown</h2>
<ul class="mt-3 space-y-3">
  <% checks.each do |c| %>
    <% bar = tones[tone_for.(c["score"], c["max"])][1] %>
    <li>
      <div class="flex justify-between text-sm">
        <span class="text-gray-700"><%= c["name"] %></span>
        <span class="text-gray-900"><%= c["score"] %> / <%= c["max"] %></span>
      </div>
      <% width = [[pct.(c["score"], c["max"]).to_f.round, 0].max, 100].min %>
      <div class="mt-1 h-2 w-full rounded-md bg-gray-200" role="progressbar" aria-label="<%= c["name"] %>" aria-valuemin="0" aria-valuemax="<%= c["max"].to_i %>" aria-valuenow="<%= c["score"].to_i %>">
        <div class="h-2 rounded-md <%= bar %>" style="width: <%= width %>%"></div>
      </div>
    </li>
  <% end %>
</ul>

<h2 class="mt-8 text-lg font-semibold text-gray-900">What to fix</h2>
<% if shortcomings.empty? %>
  <p class="mt-3 text-sm text-gray-600">No problems found. Nice work.</p>
<% else %>
  <ul class="mt-3 space-y-3">
    <% shortcomings.each do |s| %>
      <li class="rounded-md border border-gray-200 p-3 text-sm">
        <p class="font-medium text-gray-900"><%= s["name"] %>: <%= s["issue"] %></p>
        <p class="mt-1 text-gray-600"><%= s["fix"] %></p>
      </li>
    <% end %>
  </ul>
<% end %>
