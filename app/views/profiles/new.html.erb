<div class="mx-auto max-w-xl py-10">
  <h1 class="text-2xl font-semibold text-gray-900">Upload your resume</h1>
  <p class="mt-2 text-sm text-gray-600">
    We'll read your resume and check how well it works with applicant tracking systems.
  </p>

  <%= form_with scope: :profile, url: profile_path, method: :post, multipart: true, class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :resume, "Resume", class: "block text-sm font-medium text-gray-700" %>
      <%= f.file_field :resume,
            accept: ".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            required: true,
            class: "mt-1 block w-full cursor-pointer rounded-md border border-gray-300 text-sm text-gray-700 file:mr-4 file:border-0 file:bg-gray-100 file:px-4 file:py-2 file:text-gray-700 hover:file:bg-gray-200" %>
      <p class="mt-2 text-xs text-gray-500">PDF or DOCX, up to 5 MB.</p>
    </div>

    <%= f.submit "Upload and analyze",
          class: "inline-flex cursor-pointer items-center rounded-md bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800" %>
  <% end %>
</div>
