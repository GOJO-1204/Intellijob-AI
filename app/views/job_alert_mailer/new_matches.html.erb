<%# app/views/job_alert_mailer/new_matches.html.erb %>
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #222222;">
  <p style="font-size: 16px;">Hello,</p>
  <p style="font-size: 16px;">Here are your latest job matches:</p>
  <% @applications.each do |application| %>
    <% job = application.job %>
    <div style="border: 1px solid #dddddd; padding: 12px; margin-bottom: 12px;">
      <p style="margin: 0; font-size: 16px; font-weight: bold;"><%= job.title %></p>
      <p style="margin: 4px 0; font-size: 14px;"><%= job.company %><%= " - #{job.location}" if job.location.present? %></p>
      <% unless application.score.nil? %>
        <p style="margin: 4px 0; font-size: 14px;">Match: <%= (application.score * 100).round %>%</p>
      <% end %>
      <% if job.url.to_s.start_with?("http://", "https://") %>
        <p style="margin: 8px 0 0;">
          <a href="<%= job.url %>" style="display: inline-block; padding: 8px 16px; background-color: #2563eb; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: bold;">APPLY</a>
        </p>
      <% end %>
    </div>
  <% end %>
  <p style="font-size: 14px;"><a href="<%= dashboard_url %>" style="color: #2563eb;">Open your dashboard</a></p>
  <p style="font-size: 12px; color: #777777;">
    <a href="<%= unsubscribe_url(token: @user.signed_id(purpose: :unsubscribe)) %>" style="color: #777777;">Unsubscribe from these alerts</a>
  </p>
</div>