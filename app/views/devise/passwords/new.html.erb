<% label_class = "block text-sm font-medium text-gray-700" %>
<% input_class = "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
<div class="mx-auto max-w-md py-10">
  <h1 class="text-2xl font-semibold text-gray-900">Forgot your password?</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: input_class %>
    </div>

    <%= f.submit "Send me password reset instructions", class: "cursor-pointer rounded-md bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
