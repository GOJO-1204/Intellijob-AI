<% label_class = "block text-sm font-medium text-gray-700" %>
<% input_class = "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
<div class="mx-auto max-w-md py-10">
  <h1 class="text-2xl font-semibold text-gray-900">Edit <%= resource_name.to_s.humanize %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: input_class %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="text-sm text-gray-600">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
    <% end %>

    <div>
      <%= f.label :password, class: label_class %>
      <p class="text-xs text-gray-500">Leave blank if you do not want to change it.</p>
      <%= f.password_field :password, autocomplete: "new-password", class: input_class %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: label_class %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_class %>
    </div>

    <div>
      <%= f.label :current_password, class: label_class %>
      <p class="text-xs text-gray-500">We need your current password to confirm your changes.</p>
      <%= f.password_field :current_password, autocomplete: "current-password", class: input_class %>
    </div>

    <%= f.submit "Update", class: "cursor-pointer rounded-md bg-teal-700 px-4 py-2 text-sm font-medium text-white hover:bg-teal-800" %>
  <% end %>

  <h2 class="mt-10 text-lg font-semibold text-gray-900">Cancel my account</h2>
  <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "mt-3 cursor-pointer rounded-md border border-red-300 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50" %>

  <%= link_to "Back", :back, class: "mt-6 inline-block text-sm text-teal-700 hover:text-teal-800" %>
</div>
