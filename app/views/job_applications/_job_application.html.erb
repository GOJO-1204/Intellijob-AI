<% job = job_application.job %>
<li id="<%= dom_id(job_application) %>" class="rounded-md border border-gray-200 bg-white p-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="font-medium text-gray-900"><%= job.title %></p>
      <p class="text-sm text-gray-600"><%= job.company %></p>
      <% if job.location.present? %>
        <p class="text-sm text-gray-500"><%= job.location %></p>
      <% end %>
    </div>
    <% if job_application.score %>
      <p class="text-sm font-semibold text-teal-700"><%= "#{(job_application.score * 100).round}%" %></p>
    <% else %>
      <p class="text-sm text-gray-500">n/a</p>
    <% end %>
  </div>
  <%= form_with model: job_application, class: "mt-3" do |f| %>
    <div class="flex items-center gap-2">
      <%= f.select :status, JobApplication.statuses.keys.map { |s| [ s.humanize, s ] }, {},
            id: dom_id(job_application, :status), "aria-label": "Status",
            class: "rounded-md border border-gray-300 px-2 py-1 text-sm" %>
      <%= f.submit "Save", class: "rounded-md border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:bg-gray-50" %>
    </div>
  <% end %>
  <%= render "job_applications/notes", job_application: job_application,
        notice: local_assigns[:notice] %>
  <div class="mt-3 flex items-center gap-2">
    <% if job.url.to_s.match?(%r{\Ahttps?://}i) %>
      <%= link_to "Apply", job.url, target: "_blank", rel: "noopener noreferrer",
            class: "inline-flex rounded-md bg-teal-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-teal-800" %>
    <% end %>
    <%= button_to "Dismiss", job_application_path(job_application), method: :patch,
          params: { job_application: { status: "dismissed" } },
          class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50" %>
  </div>
</li>
