<% job = job_application.job %>
<li id="<%= dom_id(job_application) %>" class="rounded-md border border-gray-200 bg-white p-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="font-medium text-gray-900"><%= job.title %></p>
      <p class="text-sm text-gray-600">
        <%= job.company %><% if job.location.present? %> - <%= job.location %><% end %>
      </p>
    </div>
    <p class="text-sm font-semibold text-indigo-600">
      <%= job_application.score ? "#{(job_application.score * 100).round}%" : "n/a" %>
    </p>
  </div>
  <% if job.url.to_s.match?(%r{\Ahttps?://}i) %>
    <%= link_to "Apply", job.url, target: "_blank", rel: "noopener noreferrer",
          class: "mt-3 inline-flex rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-500" %>
  <% end %>
</li>
