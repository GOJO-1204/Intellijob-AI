<% saved_note = job_application.notes_in_database %>
<div class="mt-3">
  <% if saved_note.present? %>
    <p class="whitespace-pre-line break-words text-sm text-gray-700"><%= saved_note %></p>
  <% end %>
  <details class="mt-2" <%= "open" if job_application.errors[:notes].any? %>>
    <summary class="cursor-pointer text-sm font-medium text-[#0F766E] hover:text-[#115E59]">
      <%= saved_note.present? ? "Edit note" : "Add note" %>
    </summary>
    <%= form_with model: job_application, class: "mt-2 space-y-2" do |f| %>
      <%= f.text_area :notes, rows: 3, placeholder: "Notes", id: dom_id(job_application, :notes),
            maxlength: JobApplication::NOTES_MAX_LENGTH, "aria-label": "Notes",
            class: "w-full rounded-md border border-gray-300 px-2 py-1 text-sm" %>
      <%= f.submit "Save note", class: "rounded-md border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:bg-gray-50" %>
    <% end %>
  </details>
  <% if job_application.errors[:notes].any? %>
    <p class="mt-2 text-xs text-red-700" role="alert">
      Note is too long. Use <%= JobApplication::NOTES_MAX_LENGTH %> characters or fewer.
    </p>
  <% end %>
  <% if local_assigns[:notice] %>
    <p class="mt-2 text-xs text-green-700" role="status"><%= notice %></p>
  <% end %>
</div>
