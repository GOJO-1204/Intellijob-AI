<div class="py-16 text-center">
  <h1 class="text-3xl font-bold">Find jobs that match your resume</h1>
  <p class="mt-3 text-gray-600">Upload your resume, get an ATS score, and receive matched jobs by email.</p>
  <div class="mt-8 flex justify-center gap-4">
    <%= link_to "Sign up", new_user_registration_path, class: "rounded-md bg-teal-700 px-5 py-2.5 text-white hover:bg-teal-800" %>
    <%= link_to "Log in", new_user_session_path, class: "rounded-md border border-gray-300 bg-white px-5 py-2.5 text-gray-700 hover:bg-gray-50" %>
  </div>
</div>
