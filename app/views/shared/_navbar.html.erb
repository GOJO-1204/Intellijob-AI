    <%= link_to "JobMatch AI", root_path, class: "text-lg font-semibold text-indigo-600" %>
    <div class="flex items-center gap-4 text-sm">
      <% if user_signed_in? %>
        <%= link_to "Dashboard", dashboard_path, class: "text-gray-700 hover:text-indigo-600" %>
        <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "text-gray-700 hover:text-indigo-600" %>
      <% else %>
        <%= link_to "Log in", new_user_session_path, class: "text-gray-700 hover:text-indigo-600" %>
        <%= link_to "Sign up", new_user_registration_path, class: "rounded-md bg-indigo-600 px-3 py-1.5 text-white hover:bg-indigo-700" %>
      <% end %>
    </div>
  </div>
</nav>
