<nav class="bg-white border-b border-gray-200">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <%= link_to "IntelliJob", root_path, class: "text-lg font-semibold text-teal-700 hover:text-teal-800" %>
    <div class="flex items-center gap-4 text-sm">
      <% if user_signed_in? %>
        <%= link_to "Dashboard", dashboard_path, class: "text-gray-700 hover:text-teal-700" %>
        <%= link_to "Matches", matches_path, class: "text-gray-700 hover:text-teal-700" %>
        <%= link_to "Profile", profile_path, class: "text-gray-700 hover:text-teal-700" %>
        <%= link_to "Preferences", edit_preferences_path, class: "text-gray-700 hover:text-teal-700" %>
        <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "text-gray-700 hover:text-teal-700" %>
      <% else %>
