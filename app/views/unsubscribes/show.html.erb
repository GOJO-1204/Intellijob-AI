<div class="max-w-md mx-auto mt-16 p-6 bg-white border border-gray-200 rounded-lg">
  <h1 class="text-2xl font-semibold text-gray-900">Pause your job alerts</h1>
  <p class="mt-3 text-gray-700">Press the button to stop getting job alert emails. Nothing changes until you do.</p>
  <%= button_to "Pause my alerts", unsubscribe_path, method: :post, params: { token: @token },
        form: { data: { turbo: false } },
        class: "mt-6 cursor-pointer rounded-md bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" %>
  <%= link_to "Go to the home page", root_path,
        class: "inline-block mt-4 text-teal-700 hover:text-teal-800 underline" %>
</div>
