<% lbl = "block text-sm font-medium text-gray-700" %>
<% inp = "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
<div class="mx-auto max-w-xl py-10">
  <h1 class="text-2xl font-semibold text-gray-900">Your job preferences</h1>
  <p class="mt-2 text-sm text-gray-600">We use your answers to find jobs that match you.</p>

  <% if @profile.errors.any? %>
    <div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">
      <%= @profile.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form_with model: @profile, scope: :profile, url: preferences_path, method: :patch, class: "mt-6 space-y-5" do |f| %>
    <div>
      <%= f.label :target_role, "Target role", class: lbl %>
      <%= f.text_field :target_role, required: true, placeholder: "e.g. Ruby on Rails Developer", class: inp %>
    </div>

    <%= render "preferences/skills", profile: @profile, suggested: @suggested, lbl: lbl, inp: inp %>

    <div>
      <%= f.label :location, "Location", class: lbl %>
      <%= f.text_field :location, class: inp %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :remote, class: "h-4 w-4 rounded border-gray-300" %>
      <%= f.label :remote, "Open to remote work", class: "text-sm text-gray-700" %>
    </div>

    <div>
      <%= f.label :salary_min, "Minimum salary (optional)", class: lbl %>
      <%= f.number_field :salary_min, min: 0, class: inp %>
    </div>

    <div>
      <%= f.label :experience_level, "Experience level", class: lbl %>
      <%= f.select :experience_level, Profile::EXPERIENCE_LEVELS.map { |l| [ l.capitalize, l ] }, { include_blank: "Any" }, class: inp %>
    </div>

    <div>
      <%= f.label :alert_frequency, "Email alerts", class: lbl %>
      <%= f.select :alert_frequency, Profile::ALERT_FREQUENCIES.map { |v| [ v.capitalize, v ] }, {}, class: inp %>
    </div>

    <%= f.submit "Save preferences", class: "inline-flex cursor-pointer items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  <% end %>
</div>
